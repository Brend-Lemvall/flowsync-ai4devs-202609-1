{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(frontend/**)",
      "Write(frontend/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "mcp__atlassian__*"
    ],
    "deny": [
      "Edit(backend/**)",
      "Write(backend/**)",
      "Edit(.env*)",
      "Write(.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-frontend.sh"
          }
        ]
      }
    ]
  }
}
